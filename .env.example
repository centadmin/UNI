# Reference settings. start.sh works with NO settings at all: it uses a local
# SQLite database in backend/data/ and generates a random JWT secret there.
# To override, export these in your shell before running `bash start.sh`.

# ---- Application ----
APP_ENV=production

# ---- Database ----
# Unset = SQLite file in backend/data/ (demos, Codespaces).
# Production: PostgreSQL (e.g. AWS RDS).
DATABASE_URL=postgresql+psycopg://abc:abc_password@your-db-host:5432/abc_support

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=480

# ---- CORS (only needed if the website is hosted on a different domain) ----
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# ---- ML / business thresholds ----
CHURN_HIGH_RISK_THRESHOLD=0.60

# ---- Port (start.sh) ----
PORT=8000
